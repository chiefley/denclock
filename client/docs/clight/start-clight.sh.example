#!/bin/bash

# Locate the Surface Go ambient light sensor by name.
for device in /sys/bus/iio/devices/iio:device*; do
    [ -f "$device/name" ] || continue

    if [ "$(cat "$device/name")" = "als" ]; then
        sensor=$(basename "$device")
        break
    fi
done

if [ -z "$sensor" ]; then
    echo "Clight: ambient light sensor not found" >&2
    exit 1
fi

# Update Clight's sensor configuration.
sed -i -E \
    "s/devname = \"iio:device[0-9]+\";/devname = \"$sensor\";/" \
    "$HOME/.config/clight.conf"

# Launch Clight within the graphical session.
exec /usr/bin/clight
